# Copy this file to .env.local and fill in your Supabase project details.
# Only the public "anon" key belongs here — never the service-role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: name of the Supabase Storage bucket for uploads (defaults to "church-pics")
VITE_STORAGE_BUCKET=church-pics
